# Copy to .env and fill in. Never commit the real .env.

# --- Polymarket wallet: only needed for live trading (`run --execute`) ---
# Private key of the wallet that signs orders.
PM_PRIVATE_KEY=
# Address that holds your funds on Polymarket (the proxy wallet shown on polymarket.com).
PM_FUNDER=
# 0 = plain EOA wallet, 1 = email / Magic login, 2 = browser wallet (MetaMask etc.)
PM_SIGNATURE_TYPE=2
# Optional existing CLOB API credentials; derived from PM_PRIVATE_KEY when empty.
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Optional Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Forum topic id, if messages should go to a topic of a supergroup.
TELEGRAM_THREAD_ID=
# 1 = accept /status /pause /resume /report from TELEGRAM_CHAT_ID.
# Needs a bot token that no other service is polling (Telegram allows one getUpdates consumer).
TELEGRAM_COMMANDS=0

# --- Optional overrides ---
# BTC5M_PROFILE=conservative
# BTC5M_RUNTIME_DIR=./runtime/bot
# BTC5M_LOG_LEVEL=INFO
# PM_CLOB_HOST=https://clob.polymarket.com
